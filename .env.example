# Required for computer-use planning (Claude Haiku).
# ANTHROPIC_API_KEY=
# MINIE_PLANNER_MODEL=claude-haiku-4-5

# Optional: TypeSafe Jev for AX target picking (waitlist). Haiku picks until then.
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# Unused by the default CUA loop.
# GEMINI_API_KEY=

# Optional overrides
# MINIE_WAKE_MODEL=mlx-community/whisper-tiny
# MINIE_ASR_MODEL=mlx-community/whisper-small-mlx
# MINIE_GEMINI_MODEL=gemini-3.6-flash
# MINIE_DEBUG=0
# MINIE_DRY_RUN=0
# MINIE_NICKNAMES=papa:Papa,mom:Mom
